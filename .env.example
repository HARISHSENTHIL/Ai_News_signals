# Required. All model access goes through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: model and effort overrides. Defaults are anthropic/claude-opus-5.5
# at medium effort for curation and high for writing. Any OpenRouter model whose
# supported_parameters include `structured_outputs` works, e.g.
# anthropic/claude-haiku-5.5 (~40x cheaper) for CURATE_MODEL.
# CURATE_MODEL=anthropic/claude-opus-5.5
# WRITE_MODEL=anthropic/claude-opus-5.5
# CURATE_EFFORT=medium
# WRITE_EFFORT=high

# Optional: shown on OpenRouter's public leaderboards.
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=

# Approval gate (Telegram). Create a bot with @BotFather, then message it once
# and read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: background images. Providers are tried in order and the first that
# answers wins; with no keys at all it uses Openverse (keyless, public-domain
# only), and failing that a generated mesh gradient. Nothing here is required.
#   Pexels  - best quality, but key issuance was PAUSED as of Oct 2026
#   Pixabay - free key, open signup: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Instagram publishing (Phase 0 - fill once the Meta app is approved)
IG_USER_ID=
IG_ACCESS_TOKEN=
# Needed only by scripts/refresh_token.py
META_APP_ID=
META_APP_SECRET=

# Public base URL that Meta fetches the rendered JPEG from.
# For a public GitHub repo: https://raw.githubusercontent.com/<user>/<repo>/main
PUBLIC_BASE_URL=

# Where an approved post goes. Comma-separated; defaults to linkedin, which is
# the only one that works before Meta's App Review clears. Add instagram once it
# does: DESTINATIONS=instagram,linkedin
DESTINATIONS=linkedin

# LinkedIn publishing. Both products are self-serve and instant at
# https://www.linkedin.com/developers/apps - add "Share on LinkedIn" and
# "Sign In with LinkedIn using OpenID Connect", then set the Auth tab's
# redirect URL to http://localhost:8765/callback.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# The next three come from `python scripts/linkedin_auth.py`. The token lasts
# 60 days and CANNOT be refreshed programmatically - LinkedIn grants refresh
# tokens only to approved Marketing Developer Platform partners - so re-run
# that script when preflight starts warning.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_TOKEN_EXPIRES_AT=


# Card branding. The eyebrow across the top and the footer handle.
BRAND_NAME=AI Signals
BRAND_HANDLE=@aisignals
# Stories on the card. 5 is the legibility ceiling - 6 renders body text
# at 19px, which is about 7px once the card is scaled into a phone feed.
STORIES_PER_POST=5
